# Environment Variables Template for ABTalks Autonomous AI Creator

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/abtalks?retryWrites=true&w=majority

# Redis Connection URL (Optional - in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Python FastAPI AI Service URL
FASTAPI_AI_SERVICE_URL=http://localhost:8000

# Express Backend Port & Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here
